# OpenAI API key — used by the interviewer engine (llm/openai_client.py).
# Copy this file to .env and fill in the key. .env and .env.local are both
# gitignored; .env.local takes precedence if both exist.
OPENAI_API_KEY=your_key_here

# Optional: override the default chat model (default: gpt-4o).
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# Platform configuration (all optional; defaults are safe for local development).
# DEPLOYIQ_ENV=development
# DEPLOYIQ_LOG_LEVEL=INFO
# DEPLOYIQ_ALLOWED_ORIGINS=https://<frontend-host>

# Optional process-local platform cost estimates. Values are USD per million
# input/output tokens. Leave unset to record usage without inventing cost.
# DEPLOYIQ_MODEL_PRICES_JSON={"gpt-4o":{"input_per_1m_usd":2.5,"output_per_1m_usd":10.0}}

# Legacy alias still supported for log verbosity.
# LOG_LEVEL=DEBUG
