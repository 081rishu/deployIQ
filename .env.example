# OpenAI API key — used by the interviewer engine (llm/openai_client.py).
# Copy this file to .env and fill in the key. .env and .env.local are both
# gitignored; .env.local takes precedence if both exist.
OPENAI_API_KEY=your_key_here

# Optional: override the default chat model (default: gpt-4o).
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy

# ---------------------------------------------------------------------------
# Providers. The three legs are configured separately because free and
# low-cost providers rarely cover all three. Unset = OpenAI, so an .env with
# only OPENAI_API_KEY behaves exactly as before.
#
#   DEPLOYIQ_LLM_*   chat / JSON  (interviewer, estimator, narration)
#   DEPLOYIQ_STT_*   transcription
#   DEPLOYIQ_TTS_*   speech       (optional — a turn without audio still works)
#
# Groq has a free tier and is OpenAI-compatible for chat AND transcription:
# DEPLOYIQ_LLM_BASE_URL=https://api.groq.com/openai/v1
# DEPLOYIQ_LLM_API_KEY=gsk_...
# OPENAI_MODEL=llama-3.3-70b-versatile
# DEPLOYIQ_STT_BASE_URL=https://api.groq.com/openai/v1
# DEPLOYIQ_STT_API_KEY=gsk_...
# OPENAI_STT_MODEL=whisper-large-v3
#
# Groq's speech model is gated, so leave TTS unset and the interview runs
# without a spoken reply, or point TTS at an account that has credit.
#
# Google Gemini is OpenAI-compatible for chat only (no /audio/transcriptions):
# DEPLOYIQ_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# DEPLOYIQ_LLM_API_KEY=...
# OPENAI_MODEL=gemini-2.0-flash
#
# OPENAI_BASE_URL=  applies to any leg not given its own.
# ---------------------------------------------------------------------------

# Platform configuration (all optional; defaults are safe for local development).
# DEPLOYIQ_ENV=development
# DEPLOYIQ_LOG_LEVEL=INFO
# DEPLOYIQ_ALLOWED_ORIGINS=https://<frontend-host>

# Optional process-local platform cost estimates. Values are USD per million
# input/output tokens. Leave unset to record usage without inventing cost.
# DEPLOYIQ_MODEL_PRICES_JSON={"gpt-4o":{"input_per_1m_usd":2.5,"output_per_1m_usd":10.0}}

# Legacy alias still supported for log verbosity.
# LOG_LEVEL=DEBUG
