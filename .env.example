# OpenAI API key — used by the interviewer engine (llm/openai_client.py).
# Copy this file to .env and fill in the key. .env and .env.local are both
# gitignored; .env.local takes precedence if both exist.
OPENAI_API_KEY=your_key_here

# Optional: override the default model (default: gpt-4o).
# The interviewer does short structured-JSON calls, so a cost-optimized
# model such as gpt-4o-mini is usually enough.
# OPENAI_MODEL=gpt-4o-mini

# Optional: log verbosity for lib/logging_config.py (default: INFO).
# LOG_LEVEL=DEBUG
